@inject GameState State
@inject IJSRuntime JsRuntime
@using System.Drawing
@using Microsoft.JSInterop

<HeadContent>
    <style>
            :root {
                --board-bg:
                    @ColorTranslator.ToHtml(BoardColor)
                ;
                --player1:
                    @ColorTranslator.ToHtml(Player1Color)
                ;
                --player2:
                    @ColorTranslator.ToHtml(Player2Color)
                ;
            }

            div.board {
                margin-top: 1em;
                flex-wrap: wrap;
                width: 30em;
                height: 24em;
                overflow: hidden;
                display: inline-flex;
                flex-direction: row;
                flex-wrap: wrap;
                z-index: -5;
                row-gap: 0;
                pointer-events: none;
                border-left: 10px solid var(--board-bg);
            }

            span.container {
                width: 4em;
                height: 4em;
                margin: 0;
                padding: 4px;
                overflow: hidden;
                background-color: transparent;
                position: relative;
                z-index: -2;
                pointer-events: none;
            }

            .container span {
                width: 3.5em;
                height: 3.5em;
                border-radius: 50%;
                box-shadow: 0 0 0 3em var(--board-bg);
                left: 0px;
                position: absolute;
                display: block;
                z-index: 5;
                pointer-events: none;
            }
    </style>
</HeadContent>
<div class="scoreboard">
    <span class="player-1">@State.Player1.Name <div>@State.Player1.Score</div></span>
    <span>@RoundsLeft</span>
    <span class="player-2">@State.Player2.Name <div>@State.Player2.Score</div></span>
</div>

<article class="msg-report-container">
    @winnerMessage <button style="@ResetStyle" @onclick="ResetGame">Reset the game</button>
    @nextRoundMessage <button style="@NextRoundStyle" @onclick="NextRound">@EnterNextRoundText</button>
    <div class="alert-danger">@errorMessage</div>
    <div class="alert-info">@CurrentTurn</div>
</article>

<nav>
    @for (byte i = 0; i < 7; i++)
    {
        var col = i;
        <span class="@CurrentPlayerColor" title="Click to play a piece" @onclick="() => PlayPiece(col)">▽</span>
    }
</nav>

<div>
    <div class="board">
        @for (var i = 0; i < 42; i++)
        {
            <span class="container">
                <span></span>
            </span>
        }
    </div>

    @for (var i = 0; i < 42; i++)
    {
        <span class="@pieces[i]"></span>
    }
</div>

@code {
    [Parameter]
    public Color BoardColor { get; set; } = ColorTranslator.FromHtml("yellow");

    [Parameter]
    public Color Player1Color { get; set; } = ColorTranslator.FromHtml("red");

    [Parameter]
    public Color Player2Color { get; set; } = ColorTranslator.FromHtml("blue");

    private string CurrentPlayerColor = "player-1-color";

    private string[] pieces = new string[42];
    private string winnerMessage = string.Empty;
    private string errorMessage = string.Empty;
    private string nextRoundMessage = string.Empty;
    private string EnterNextRoundText => State.Rounds == 1 ? "Enter Final Round" : $"Enter Round {GetGetRoundValue()}";

    private string CurrentTurn => (winnerMessage == string.Empty && nextRoundMessage == string.Empty) ? $"It's {GetPlayerTurn()}'s Turn" : "";
    private string ResetStyle => (winnerMessage == string.Empty) ? "display: none;" : "";
    private string NextRoundStyle => (nextRoundMessage == string.Empty) ? "display: none;" : "";

    private bool Paused => (winnerMessage != string.Empty || nextRoundMessage != string.Empty);

    private string RoundsLeft => DisplayRoundGraphics();

    private string DisplayRoundGraphics()
    {
        if (State.Rounds == 0) return "Game Over";

        string roundGraphics = string.Empty;
        for (int i = 0; i < State.Rounds; i++)
        {
            roundGraphics += "💝";
        }
        return roundGraphics;
    }

    private void PlayPiece(byte col)
    {
        if (Paused) return;

        errorMessage = string.Empty;
        try
        {
            var player = State.PlayerTurn;
            var turn = State.CurrentTurn;
            var landingRow = State.PlayPiece(col);
            pieces[turn] = $"player{player} col{col} drop{landingRow}";

            // update current player color
            CurrentPlayerColor = player == 1 ? "player-2-color" : "player-1-color";
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
            return;
        }

        nextRoundMessage = State.CalculateRound() switch
        {
            GameState.WinState.Player1_Round_Winner => $"{State.Player1.Name} Wins Round {GetGetRoundValue() - 1}!",
            GameState.WinState.Player2_Round_Winner => $"{State.Player2.Name} Wins Round {GetGetRoundValue() - 1}!",
            GameState.WinState.No_Round_Winner => $"No one wins Round {GetGetRoundValue() - 1}!",
            _ => "" // GameState.WinState.No_Winner = string.Empty;
        };

        winnerMessage = State.CalculateRound() switch
        {
            GameState.WinState.Player1_Wins => $"{State.Player1.Name} Wins!",
            GameState.WinState.Player2_Wins => $"{State.Player2.Name} Wins!",
            GameState.WinState.Tie => "It's a tie!",
            _ => "" // GameState.WinState.No_Winner = string.Empty;
        };
    }

    private string GetPlayerTurn()
    {
        return State.PlayerTurn == 1 ? State.Player1.Name : State.Player2.Name;
    }

    private int GetGetRoundValue()
    {
        return GameState.StartRound - State.Rounds + 1;
    }

    private void SetGamePlayers(string player1Name, string player2Name, int rounds, Color player1Color, Color player2Color)
    {
        State.SetPlayers(rounds, player1Name, player2Name, player1Color, player2Color);
        ResetGame();
    }

    private void NextRound()
    {
        State.ResetBoard();
        nextRoundMessage = string.Empty;
        winnerMessage = string.Empty;
        errorMessage = string.Empty;
        pieces = new string[42];
    }

    void ResetGame()
    {
        State.ResetGame();
        winnerMessage = string.Empty;
        errorMessage = string.Empty;
        nextRoundMessage = string.Empty;
        pieces = new string[42];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            string? player1Name = await JsRuntime.InvokeAsync<string?>("prompt", "Please enter your name for Player 1:", "Player 1");
            string? player2Name = await JsRuntime.InvokeAsync<string?>("prompt", "Please enter your name for Player 2:", "Player 2");
            string? rounds = await JsRuntime.InvokeAsync<string?>("prompt", "Please enter the number of rounds to play:", "1");
            int roundValue = int.TryParse(rounds, out var roundCount) && roundCount >= 1
                ? roundCount
                : 1; // To ensure at least 1 round

            SetGamePlayers(player1Name ?? "Player 1", player2Name ?? "Player 2", roundValue, Player1Color, Player2Color);
            StateHasChanged(); // method needed to force a re-render to update the UI with the new player names and round count
        }
    }
}